# Copy to .env and fill in.  Credentials do NOT go here — see ./secrets/.

# --- UniFi console (local, no cloud) ---------------------------------------
UNIFI_HOST=192.168.1.1
UNIFI_SITE=default
# Preferred: an API key in ./secrets/unifi-api-key (scripts/install-unifi-key.sh).
# Fallback, if your firmware rejects X-API-KEY on the classic endpoints — verify
# with verify_unifi_auth.py — a read-only local admin:
UNIFI_USERNAME=
UNIFI_PASSWORD=

# --- Telegram ---------------------------------------------------------------
# Safe to reuse an existing bot's token: sending does not conflict with another
# process long-polling it. See src/notify.py for why approvals are URLs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- What to switch to ------------------------------------------------------
# Plan ids are region- and hardware-specific; there is no sensible default.
# Run recon.py to print the ids your line is offered, with live prices:
#   docker compose run --rm starlink-standby-failover python recon.py
# e.g. us-consumer-subscription-mini-roam-100-0526
TARGET_PRODUCT_ID=

# --- Safety -----------------------------------------------------------------
# A nonsense-tripwire, NOT a budget. You are charged the prorated difference
# between standby and the target plan, so the true worst case is roughly one
# month of (target - standby). Set this comfortably above that: a guard that
# refuses a legitimate switch defeats the point of owning a backup link.
MAX_SPEND_USD=200

# Minutes the primary must be continuously down before spending money. Short
# blips self-restore; anything under ~10 buys you charges, not uptime.
DEBOUNCE_MINUTES=20

POLL_SECONDS=30

# Leave true until you have watched it decide correctly at least once.
DRY_RUN=true

# auto    = switch on debounce + tripwire alone (recommended: fires while you sleep)
# confirm = send Telegram approve/deny links and wait for a tap
APPROVAL_MODE=auto
APPROVAL_PORT=8788
APPROVAL_TIMEOUT_MINUTES=30
# Must be reachable from your phone.
APPROVAL_BASE_URL=http://192.168.1.20:8788

# --- Housekeeping -----------------------------------------------------------
# Putting the line back on Standby Mode before your bill renews.
#
# REVERT_DAY_OF_MONTH is the EARLIEST day to revert (0 disables the whole
# thing). BILLING_RESET_DAY is your renewal day — check your payment history,
# it is probably not the 1st. The revert is attempted every day in
# [REVERT_DAY_OF_MONTH, BILLING_RESET_DAY), not just once, because a switch
# triggered after a single fixed day would never be reverted and would cost a
# full month at plan rate.
#
# Leave a few days of slack: a queued standby that misses the boundary is
# exactly the failure this is trying to avoid.
REVERT_DAY_OF_MONTH=0
BILLING_RESET_DAY=0

# How often to prove the whole chain still works and alert if not. 168 = weekly.
CANARY_INTERVAL_HOURS=168

TZ=UTC
